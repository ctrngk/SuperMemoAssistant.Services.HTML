<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <OutputType>Library</OutputType>
        <Deterministic>true</Deterministic>
        <AssemblyName>PluginManager.Core</AssemblyName>
        <RootNamespace>PluginManager</RootNamespace>
        <LangVersion>latest</LangVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup Label="Package">
        <Title>Plugin Manager Core</Title>
        <Description>Core library for plugin management, including NuGet package management and plugin lifecycle.</Description>
        <PackageProjectUrl>https://github.com/supermemo/PluginManager</PackageProjectUrl>
        <PackageReleaseNotes></PackageReleaseNotes>
        <PackageTags>PluginManager,Core,NuGet,Plugins</PackageTags>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <DocumentationFile>bin\Debug\PluginManager.Core.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>pdbonly</DebugType>
        <DefineConstants>TRACE</DefineConstants>
        <Optimize>true</Optimize>
        <DocumentationFile>bin\Release\PluginManager.Core.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="System" />
        <Reference Include="System.ComponentModel.Composition" />
        <Reference Include="System.Core" />
        <Reference Include="System.Data" />
        <Reference Include="System.IdentityModel" />
        <Reference Include="System.IO.Compression" />
        <Reference Include="System.Net.Http" />
        <Reference Include="System.Numerics" />
        <Reference Include="System.Runtime.Remoting" />
        <Reference Include="System.Security" />
        <Reference Include="System.ServiceModel" />
        <Reference Include="System.Xml" />
        <Reference Include="System.Xml.Linq" />
        <Reference Include="Microsoft.CSharp" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Anotar.Custom.Fody">
            <Version>5.1.0</Version>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommandLineParser">
            <Version>2.7.82</Version>
        </PackageReference>
        <PackageReference Include="Extensions.System.IO">
            <Version>0.1.0.3</Version>
        </PackageReference>
        <PackageReference Include="Fody">
            <Version>6.1.1</Version>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Web.Xdt">
            <Version>3.0.0</Version>
        </PackageReference>
        <PackageReference Include="Newtonsoft.Json">
            <Version>12.0.3</Version>
        </PackageReference>
        <PackageReference Include="Nito.AsyncEx.Context">
            <Version>5.0.0</Version>
        </PackageReference>
        <PackageReference Include="Nito.AsyncEx.Coordination">
            <Version>5.0.0</Version>
        </PackageReference>
        <PackageReference Include="Nito.AsyncEx.Interop.WaitHandles">
            <Version>5.0.0</Version>
        </PackageReference>
        <PackageReference Include="Nito.AsyncEx.Oop">
            <Version>5.0.0</Version>
        </PackageReference>
        <PackageReference Include="Nito.AsyncEx.Tasks">
            <Version>5.0.0</Version>
        </PackageReference>
        <PackageReference Include="Nito.Cancellation">
            <Version>1.0.5</Version>
        </PackageReference>
        <PackageReference Include="Nito.Collections.Deque">
            <Version>1.0.4</Version>
        </PackageReference>
        <PackageReference Include="Nito.Disposables">
            <Version>2.0.1</Version>
        </PackageReference>
        <PackageReference Include="NuGet.Commands">
            <Version>5.4.0</Version>
        </PackageReference>
        <PackageReference Include="NuGet.Common">
            <Version>5.4.0</Version>
        </PackageReference>
        <PackageReference Include="NuGet.Configuration">
            <Version>5.4.0</Version>
        </PackageReference>
        <PackageReference Include="NuGet.Credentials">
            <Version>5.4.0</Version>
        </PackageReference>
        <PackageReference Include="NuGet.DependencyResolver.Core">
            <Version>5.4.0</Version>
        </PackageReference>
        <PackageReference Include="NuGet.Frameworks">
            <Version>5.4.0</Version>
        </PackageReference>
        <PackageReference Include="NuGet.LibraryModel">
            <Version>5.4.0</Version>
        </PackageReference>
        <PackageReference Include="NuGet.PackageManagement">
            <Version>5.4.0</Version>
        </PackageReference>
        <PackageReference Include="NuGet.Packaging">
            <Version>5.4.0</Version>
        </PackageReference>
        <PackageReference Include="NuGet.Packaging.Core">
            <Version>5.4.0</Version>
        </PackageReference>
        <PackageReference Include="NuGet.ProjectModel">
            <Version>5.4.0</Version>
        </PackageReference>
        <PackageReference Include="NuGet.Protocol">
            <Version>5.4.0</Version>
        </PackageReference>
        <PackageReference Include="NuGet.Resolver">
            <Version>5.4.0</Version>
        </PackageReference>
        <PackageReference Include="NuGet.Versioning">
            <Version>5.4.0</Version>
        </PackageReference>
        <PackageReference Include="PropertyChanged.Fody">
            <Version>3.2.8</Version>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="System.Buffers">
            <Version>4.5.0</Version>
        </PackageReference>
        <PackageReference Include="System.Collections.Immutable">
            <Version>1.7.0</Version>
        </PackageReference>
        <PackageReference Include="System.Memory">
            <Version>4.5.3</Version>
        </PackageReference>
        <PackageReference Include="System.Numerics.Vectors">
            <Version>4.5.0</Version>
        </PackageReference>
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe">
            <Version>4.7.0</Version>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PluginManager.Interop\PluginManager.Interop.csproj" />
        <ProjectReference Include="..\PluginManager.PluginHost\PluginManager.PluginHost.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Properties\" />
    </ItemGroup>

    <Target Name="NuPack" AfterTargets="Build" Condition=" $(RunNuPack) == 'True' ">
        <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
            <Output TaskParameter="Assemblies" ItemName="myAssemblyInfo" />
        </GetAssemblyIdentity>
        <ItemGroup>
            <NuGetExe Include="$(SolutionDir)tools\nuget.exe" />
            <VersionNumber Include="@(myAssemblyInfo->'%(Version)')" />
        </ItemGroup>
        <Exec Command="&quot;%(NuGetExe.FullPath)&quot; pack $(AssemblyName).nuspec -Version @(VersionNumber) -Properties Configuration=$(Configuration) -OutputDirectory $(SolutionDir)Releases -BasePath $(OutDir)" />
    </Target>

</Project>